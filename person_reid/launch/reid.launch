<launch>
  <!-- 人员重识别节点。用法:
         roslaunch person_reid reid.launch
         roslaunch person_reid reid.launch threshold:=0.72 gallery:=/path/to/gallery.npz
  -->

  <arg name="image_topic"  default="/camera/image_raw"/>
  <arg name="gallery"      default="$(find person_reid)/gallery/gallery.npz"/>
  <arg name="weights"      default="$(find person_reid)/models/osnet_x1_0_msmt17.pth"/>
  <arg name="detector"     default="$(find person_reid)/models/yolov8n.pt"/>
  <arg name="threshold"    default="0.6"/>
  <arg name="conf_det"     default="0.5"/>
  <arg name="min_person_h" default="40"/>
  <arg name="tta_flip"     default="true"/>
  <arg name="threads"      default="2"/>
  <arg name="continuous"   default="false"/>

  <node pkg="person_reid" type="reid_node.py" name="person_reid" output="screen">
    <param name="image_topic"   value="$(arg image_topic)"/>
    <param name="gallery"       value="$(arg gallery)"/>
    <param name="weights"       value="$(arg weights)"/>
    <param name="detector_weights" value="$(arg detector)"/>
    <param name="threshold"     value="$(arg threshold)"/>
    <param name="conf_det"      value="$(arg conf_det)"/>
    <param name="min_person_h"  value="$(arg min_person_h)"/>
    <param name="tta_flip"      value="$(arg tta_flip)"/>
    <param name="threads"       value="$(arg threads)"/>
    <param name="continuous"    value="$(arg continuous)"/>
  </node>

  <!-- 需要看识别画面时打开(可选):
       rosrun image_view image_view image:=/reid/annotated -->
</launch>
