<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="traffic_light">
    <static>true</static>

    <link name="frame_link">

      <!-- 左立柱 -->
      <visual name="left_post_visual">
        <pose>-0.3325 0 0.24 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.025 0.48</size>
          </box>
        </geometry>
        <material>
          <ambient>0.22 0.22 0.22 1</ambient>
          <diffuse>0.32 0.32 0.32 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <!-- 右立柱 -->
      <visual name="right_post_visual">
        <pose>0.3325 0 0.24 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.025 0.48</size>
          </box>
        </geometry>
        <material>
          <ambient>0.22 0.22 0.22 1</ambient>
          <diffuse>0.32 0.32 0.32 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <!-- 灯盒外壳 -->
      <visual name="housing_visual">
        <pose>0 -0.007 0.41 0 0 0</pose>
        <geometry>
          <box>
            <size>0.64 0.036 0.14</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>

      <!-- 左立柱碰撞体 -->
      <collision name="left_post_collision">
        <pose>-0.3325 0 0.24 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.025 0.48</size>
          </box>
        </geometry>
      </collision>

      <!-- 右立柱碰撞体 -->
      <collision name="right_post_collision">
        <pose>0.3325 0 0.24 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.025 0.48</size>
          </box>
        </geometry>
      </collision>

      <!--
        灯盒碰撞体。
        同时覆盖灯盒外壳以及前方凸出的灯盘。
      -->
      <collision name="housing_collision">
        <pose>0 -0.0005 0.41 0 0 0</pose>
        <geometry>
          <box>
            <size>0.64 0.049 0.14</size>
          </box>
        </geometry>
      </collision>

    </link>

    <!-- 三个灯等距：x=-0.20、0、0.20 m，灯面朝 +Y -->

    <!-- 红灯 -->
    <link name="red_lamp">
      <pose>-0.20 0.018 0.41 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <emissive>0 0 0 1</emissive>
        </material>

        <plugin name="traffic_light_red_controller"
                filename="libtraffic_light_plugin.so">
          <role>red</role>
          <green_duration>15</green_duration>
          <yellow_duration>3</yellow_duration>
          <red_duration>10</red_duration>
        </plugin>
      </visual>
    </link>

    <!-- 黄灯 -->
    <link name="yellow_lamp">
      <pose>0 0.018 0.41 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <emissive>0 0 0 1</emissive>
        </material>

        <plugin name="traffic_light_yellow_controller"
                filename="libtraffic_light_plugin.so">
          <role>yellow</role>
          <green_duration>15</green_duration>
          <yellow_duration>3</yellow_duration>
          <red_duration>10</red_duration>
        </plugin>
      </visual>
    </link>

    <!-- 绿灯 -->
    <link name="green_lamp">
      <pose>0.20 0.018 0.41 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 1.0 0.10 1</ambient>
          <diffuse>0.10 1.0 0.10 1</diffuse>
          <emissive>0.15 1.0 0.15 1</emissive>
        </material>

        <plugin name="traffic_light_green_controller"
                filename="libtraffic_light_plugin.so">
          <role>green</role>
          <green_duration>15</green_duration>
          <yellow_duration>3</yellow_duration>
          <red_duration>10</red_duration>
        </plugin>
      </visual>
    </link>

  </model>
</sdf>