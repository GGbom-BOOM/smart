<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="traffic_light">
    <static>true</static>

    <!-- 路口横向红绿灯（镜像到对侧）：立柱高1 m，顶端横杆伸向 -X，横排 红-黄-绿（绿灯常亮） -->

    <!-- ============ 立柱（高1，0~1.0） ============ -->
    <link name="pole_link">
      <pose>0 0 0.5 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.025</radius><length>1.0</length></cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.35 0.35 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- ============ 顶端横杆（沿 -X） ============ -->
    <link name="arm_link">
      <pose>-0.4 0 1.02 0 1.5708 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.020</radius><length>0.8</length></cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.35 0.35 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- ============ 横排灯头外壳（在 -X 侧） ============ -->
    <link name="housing_link">
      <pose>-0.5 0 0.90 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box><size>0.44 0.13 0.20</size></box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- ============ 红灯（灭） ============ -->
    <link name="red_lamp">
      <pose>-0.38 0.075 0.90 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.055</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ============ 黄灯（灭） ============ -->
    <link name="yellow_lamp">
      <pose>-0.50 0.075 0.90 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.055</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ============ 绿灯（常亮） ============ -->
    <link name="green_lamp">
      <pose>-0.62 0.075 0.90 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.055</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.10 1.0 0.10 1</ambient>
          <diffuse>0.10 1.0 0.10 1</diffuse>
          <emissive>0.15 1.0 0.15 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>