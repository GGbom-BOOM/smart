<!--
    使用 xacro 优化 URDF 版的小车底盘实现：

    实现思路:
    1.将一些常量、变量封装为 xacro:property
      比如:PI 值、小车底盘半径、离地间距、车轮半径、宽度 ....
    2.使用 宏 封装驱动轮以及支撑轮实现，调用相关宏生成驱动轮与支撑轮

-->
<!-- 根标签，必须声明 xmlns:xacro -->
<robot name="my_base" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 封装变量、常量 -->
    <xacro:property name="PI" value="3.141"/>
    <!-- 宏:黑色设置 -->
    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0" />
    </material>
    <!-- 底盘属性 -->
    <xacro:property name="base_footprint_radius" value="0.002" /> <!-- base_footprint 半径  -->
    <xacro:property name="base_link_length" value="0.30" /> <!-- base_link 长 -->
    <xacro:property name="base_link_width" value="0.20" /> <!-- base_link 宽-->
    <xacro:property name="base_link_height" value="0.10" /> <!-- base_link高 -->
    <xacro:property name="base_link_mass" value="6" />
    <xacro:property name="earth_space" value="0.030" /> <!-- 离地间距 -->

    <!-- 底盘 -->
    <link name="base_footprint">
      <visual>
        <geometry>
          <sphere radius="${base_footprint_radius}" />
        </geometry>
      </visual>
    </link>

    <link name="base_link">
      <visual>
        <geometry>
          <box size="${base_link_length} ${base_link_width} ${base_link_height}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material name="blue">
          <color rgba="0.0 0.0 1.0 0.9" />
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${base_link_length} ${base_link_width} ${base_link_height}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
      </collision>
      <!-- 调用惯性矩阵函数 -->
      <xacro:Box_inertial_matrix m="${base_link_mass}" l="${base_link_length}" w="${base_link_width}" h="${base_link_height}"/>
    </link>
    
    <gazebo reference="base_link">
      <material>Gazebo/Blue</material>
    </gazebo>
    <joint name="base_link2base_footprint" type="fixed">
      <parent link="base_footprint" />
      <child link="base_link" />
      <origin xyz="0 0 ${earth_space + base_link_height / 2 }" />
    </joint>

    <!-- 驱动轮 -->
  <xacro:property name="wheel_radius" value="0.0650" /><!-- 半径 -->
  <xacro:property name="wheel_length" value="0.030" /><!-- 宽度 -->
  <xacro:property name="wheel_mass" value="0.4"/>
    <!-- 驱动轮宏实现 -->
    <xacro:macro name="add_drive_wheels" params="name flag ">
      <link name="${name}_wheel">
        <visual>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_length}" />
          </geometry>
          <origin xyz="0.0 0.0 0.0" rpy="${PI / 2} 0.0 0.0" />
          <material name="black" />
        </visual>
        <collision>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_length}" />
          </geometry>
          <origin xyz="0.0 0.0 0.0" rpy="${PI / 2} 0.0 0.0" />
        </collision>
        <xacro:cylinder_inertial_matrix m="${wheel_mass}" r="${wheel_radius}" h="${wheel_length}"/>
      </link>
      <gazebo reference="${name}_wheel">
        <material>Gazebo/Green</material>
      </gazebo> 
      <joint name="${name}_wheel2base_link" type="continuous">
        <parent link="base_link" />
        <child link="${name}_wheel" />
        <origin xyz="0 ${flag * (base_link_width/2+wheel_length/2)} ${-(earth_space + base_link_height  / 2 - wheel_radius) }" />
        <axis xyz="0 1 0" />
      </joint>
    </xacro:macro>
  <xacro:add_drive_wheels name="left" flag="1" />
  <xacro:add_drive_wheels name="right" flag="-1" />

  <xacro:property name="support_wheel_radius" value="0.0150" /> <!-- 支撑轮半径 -->
    <xacro:property name="support_wheel_mass" value="0.06" /> <!-- 质量  -->

    <!-- 支撑轮宏 -->
    <xacro:macro name="add_support_wheel" params="name flag" >
      <link name="${name}_wheel">
        <visual>
            <geometry>
                <sphere radius="${support_wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${support_wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertial_matrix m="${support_wheel_mass}" r="${support_wheel_radius}" />
      </link>

      <joint name="${name}_wheel2base_link" type="continuous">
          <parent link="base_link" />
          <child link="${name}_wheel" />
          <origin xyz="${flag * (base_link_length/2 - support_wheel_radius)} 0 ${-(base_link_height / 2 + earth_space / 2)}" />
          <axis xyz="1 1 1" />
      </joint>
      <gazebo reference="${name}_wheel">
        <material>Gazebo/Red</material>
      </gazebo>
    </xacro:macro>

    <xacro:add_support_wheel name="front" flag="1" />
    <xacro:add_support_wheel name="back" flag="-1" />
  
</robot>


 
    