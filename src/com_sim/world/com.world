<?xml version="1.0" ?>
<sdf version="1.7">

<world name="competition_world">

  <ambient>0.8 0.8 0.8 1</ambient>

  <physics type="ode">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
    <real_time_update_rate>1000</real_time_update_rate>
  </physics>

  <light type="directional" name="sun">
    <cast_shadows>false</cast_shadows>
    <pose>0 0 50 0 0 0</pose> <!-- 提高光源高度从10改为50 -->
    <diffuse>1.0 1.0 1.0 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular> <!-- 降低镜面反射从0.0改为 -->
    <direction>0 0 -1</direction>
  </light>

  <!-- 比赛场地和墙体模型 -->
  <include>
    <uri>model://competition_ground</uri>
    <pose>0 0 0.05 0 0 0</pose> <!-- 添加pose，稍微抬高地面 -->
  </include>

  <!-- 人物立牌1 -->
  <include>
    <uri>model://ro1</uri>
    <pose>-1.3 1.8 0 0 0 0</pose> 
    <name>person_area_1</name>
  </include>

  <!-- 人物立牌2 -->
  <include>
    <uri>model://ro2</uri>
    <pose>-1.3 -0.6 0 0 0 3.14159</pose> 
    <name>person_area_2</name>
  </include>

 <!-- 车牌立牌1-->
  <include>
    <uri>model://cp</uri>
    <pose>2.55 -1.55 0 0 0 4.71239</pose> 
    <name>car_plate_area</name>
  </include>

  <!-- 车牌立牌2-->
  <include>
    <uri>model://cp2</uri>
    <pose>2.55 -0.72 0 0 0 4.71239</pose> 
    <name>car_plate_area_2</name>
  </include>

 <!-- 车牌立牌3-->
  <include>
    <uri>model://cp3</uri>
    <pose>2.55 -2.45 0 0 0 4.71239</pose> 
    <name>car_plate_area_3</name>
  </include>

  <!-- ==============================================
       红绿灯1（位置/朝向自己改 pose）
       说明：模型本地坐标里灯面朝 +Y；yaw 用来转方向。
       例如想看灯面朝 -X，就把 yaw 改成 1.5708。
  ============================================== -->
  <include>
    <uri>model://traffic_light</uri>
    <pose>0 1.85 0.05 0 0 -1.5708</pose>
    <name>traffic_light_1</name>
  </include>

  <!--红绿灯2-->
  <include>
    <uri>model://traffic_light_b</uri>
    <pose>-0.8 -1.2 0.05 0 0 0</pose>
    <name>traffic_light_2</name>

  </include>


</world>
</sdf>
